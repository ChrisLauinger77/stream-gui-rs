{
  "name": "stream-gui-rs",
  "version": "0.4.0",
  "description": "A modern Rust/Tauri desktop frontend for watching Twitch streams via Streamlink",
  "license": "GPL-3.0-only",
  "repository": "https://github.com/ChrisLauinger77/stream-gui-rs",
  "homepage": "https://github.com/ChrisLauinger77/stream-gui-rs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "bindings": "cargo run --manifest-path src-tauri/Cargo.toml --no-default-features --example export_bindings",
    "release:version": "node scripts/set-version.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^30.0.0",
    "typescript": "~7.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
