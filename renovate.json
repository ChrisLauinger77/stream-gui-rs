{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>ChrisLauinger77/ChrisLauinger77//renovate-config/stream-gui-rs"
  ],
  "packageRules": [
    {
      "description": "Keep unrelated npm updates independently reviewable",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "!@tauri-apps/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": null
    },
    {
      "description": "Keep unrelated Rust updates independently reviewable",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "!tauri",
        "!tauri-build"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": null
    },
    {
      "description": "Vite and its React plugin must move together",
      "matchManagers": [
        "npm"
      ],
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "vite",
        "@vitejs/plugin-react"
      ],
      "groupName": "Vite toolchain"
    },
    {
      "description": "Node and jsdom runtime requirements must move together",
      "matchManagers": [
        "npm",
        "github-actions"
      ],
      "matchDatasources": [
        "npm",
        "node-version"
      ],
      "matchPackageNames": [
        "node",
        "jsdom"
      ],
      "groupName": "Node.js test runtime"
    },
    {
      "description": "Windows API crates move together; migrations require full CI, a packaged Windows artifact and notification/tray/Notification Center/activation smoke tests",
      "matchManagers": [
        "cargo"
      ],
      "matchDatasources": [
        "crate"
      ],
      "matchPackageNames": [
        "windows",
        "windows-core"
      ],
      "groupName": "Windows API crates"
    },
    {
      "description": "Defer Windows API generation changes (breaking 0.x minor and major updates) until deliberately re-enabled after v0.2.0; allow compatible patches",
      "matchManagers": [
        "cargo"
      ],
      "matchDatasources": [
        "crate"
      ],
      "matchPackageNames": [
        "windows",
        "windows-core"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Keep GTK aligned with Tauri/Wry gtk-rs; defer breaking 0.x minor and major updates until stack-compatible, then require a Linux native build and graphical notification/tray/browser/lifecycle smoke tests",
      "matchManagers": [
        "cargo"
      ],
      "matchDatasources": [
        "crate"
      ],
      "matchPackageNames": [
        "gtk"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "enabled": false
    },
    {
      "description": "GIO generation changes follow Tauri/Wry gtk-rs compatibility",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "gio"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "enabled": false
    }
  ]
}
