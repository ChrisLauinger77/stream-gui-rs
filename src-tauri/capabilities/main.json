{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Browsing, authentication and domain-specific playback, only in the local main window.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-backend-diagnostics",
    "allow-streamlink-probe",
    "allow-streamlink-launch",
    "allow-streamlink-stop",
    "allow-streamlink-sessions",
    "allow-streamlink-restart",
    "allow-playback-settings",
    "allow-channel-settings",
    "allow-open-channel-chat",
    "allow-save-channel-settings",
    "allow-save-playback-settings",
    "allow-discover-players",
    "allow-auth-status",
    "allow-auth-login",
    "allow-auth-open-verification",
    "allow-auth-validate",
    "allow-auth-refresh",
    "allow-auth-logout",
    "allow-auth-cancel",
    "allow-auth-account",
    "allow-list-followed-streams",
    "allow-list-followed-channels",
    "allow-list-streams",
    "allow-list-categories",
    "allow-list-category-streams",
    "allow-search-channels",
    "allow-search-categories",
    "allow-get-channel"
  ]
}
